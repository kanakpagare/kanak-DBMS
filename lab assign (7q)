-- ============================================================
-- Question 7
-- Write a SQL statement to create a table named countries including columns country_id, country_name and region_id and make sure that no countries except Italy, India and China will be entered in the table.
-- ============================================================

CREATE DATABASE IF NOT EXISTS practice_db;
USE practice_db;

-- Purani tables hata do (child pehle, parent baad me)
SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS countries;
SET FOREIGN_KEY_CHECKS = 1;

-- ------------------------------------------------------------
-- Solution
-- ------------------------------------------------------------
CREATE TABLE countries (
    country_id   INT,
    country_name VARCHAR(50),
    region_id    INT,
    CONSTRAINT chk_country_name CHECK (country_name IN ('Italy', 'India', 'China'))
);

-- ------------------------------------------------------------
-- Structure check
-- ------------------------------------------------------------
DESCRIBE countries;

-- ------------------------------------------------------------
-- Test (commented lines ko uncomment karke error dekh sakte ho)
-- ------------------------------------------------------------
INSERT INTO countries VALUES (1, 'India', 10);          -- OK
-- INSERT INTO countries VALUES (2, 'Japan', 20);       -- ERROR: allowed nahi
SELECT * FROM countries;
